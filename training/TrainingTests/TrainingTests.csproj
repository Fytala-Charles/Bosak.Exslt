<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Training test project: no public API surface, so no XML documentation file
         is generated. IDE0005 cannot run on build without doc generation
         (roslyn#41640), so it is suppressed here. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Bosak.Xslt" Version="0.12.3-beta" />
    <PackageReference Include="Bosak.XPath.Providers" Version="0.12.3-beta" />
  </ItemGroup>

  <ItemGroup>
    <!-- Training sessions are copied so the transforms resolve their session's
         input.xml and case/ files from their copied location in the output
         directory. Training stylesheets are self-contained: unlike the golden
         corpus they never include src/, so no library copy is needed here.
         Sessions 00-09 live under 0*, sessions 10+ under 1*; the TrainingTests
         discovery enumerates every directory and filters on case/meta.json. -->
    <None Include="..\0*\**\*.*" CopyToOutputDirectory="PreserveNewest" LinkBase="training" />
    <None Include="..\1*\**\*.*" CopyToOutputDirectory="PreserveNewest" LinkBase="training" />
  </ItemGroup>

</Project>
